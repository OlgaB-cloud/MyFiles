# Авито: https://www.avito.ru/professionals/api (Client ID и Client Secret)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Telegram: токен от @BotFather и ваш chat id (узнать можно у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Как часто проверять новые сообщения, секунд
POLL_INTERVAL=30
# Помечать чаты на Авито прочитанными после пересылки (true/false)
MARK_AS_READ=false
STATE_FILE=state.json
